{
  "name": "drizzle-adapter",
  "version": "1.4.1",
  "description": "Drizzle ORM adapter for Casbin",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "publishConfig": {
    "tag": "latest",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "precommit": "lint-staged",
    "prepublish": "yarn run lint && yarn build",
    "build": "rimraf lib && rollup -c",
    "coverage": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.{ts,js,jsx}\"",
    "fix": "eslint \"src/**/*.{ts,js,jsx}\" --fix",
    "test": "jest --runInBand",
    "release": "npx -p semantic-release -p @semantic-release/git -p @semantic-release/changelog -p @semantic-release/github semantic-release"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "better-sqlite3": "^13.0.3",
    "casbin": "^5.30.0",
    "coveralls": "^3.1.1",
    "drizzle-orm": "^0.45.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.0.0",
    "lint-staged": "^15.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^3.29.5"
  },
  "peerDependencies": {
    "casbin": "^5.0.0",
    "drizzle-orm": ">=0.29.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "files": [
    "lib",
    "examples",
    "NOTICE",
    "DISCLAIMER"
  ],
  "homepage": "https://casbin.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/casbin-node-extensions.git",
    "directory": "packages/adapters/drizzle-adapter"
  },
  "keywords": [
    "casbin",
    "node-casbin",
    "adapter",
    "drizzle",
    "drizzle-orm",
    "access-control",
    "authorization",
    "auth",
    "authz",
    "acl",
    "rbac",
    "abac",
    "orm"
  ],
  "author": "Node-Casbin",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "bugs": {
    "url": "https://github.com/apache/casbin-node-extensions/issues"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "jest": {
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "testMatch": [
      "**/test/*.test.+(ts|tsx)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
