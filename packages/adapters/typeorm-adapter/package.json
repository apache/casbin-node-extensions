{
  "name": "typeorm-adapter",
  "version": "1.10.1",
  "description": "TypeORM adapter for Casbin",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "precommit": "lint-staged",
    "prepublish": "yarn run lint && yarn build",
    "build": "rimraf lib && rollup -c",
    "coverage": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.{ts,js,jsx}\"",
    "fix": "eslint \"src/**/*.{ts,js,jsx}\" --fix",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^23.3.5",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "better-sqlite3": "^13.0.3",
    "coveralls": "^3.0.2",
    "eslint": "^8.49.0",
    "husky": "^1.1.2",
    "jest": "^28.1.3",
    "jest-environment-node": "^28.0.0",
    "lint-staged": "^7.3.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.15.3",
    "pg": "^8.4.2",
    "rimraf": "^2.6.2",
    "ts-jest": "28.0.7",
    "typescript": "^5.1.6",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^3.29.5",
    "rollup-plugin-dts": "^5.3.1"
  },
  "dependencies": {
    "casbin": "^5.27.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "mongodb": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "examples",
    "NOTICE",
    "DISCLAIMER"
  ],
  "homepage": "https://casbin.apache.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/casbin-node-extensions.git",
    "directory": "packages/adapters/typeorm-adapter"
  },
  "keywords": [
    "casbin",
    "node-casbin",
    "adapter",
    "typeorm",
    "access-control",
    "authorization",
    "auth",
    "authz",
    "acl",
    "rbac",
    "abac",
    "orm"
  ],
  "author": "Node-Casbin",
  "licenses": [
    {
      "type": "Apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "bugs": {
    "url": "https://github.com/apache/casbin-node-extensions/issues"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "jest": {
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "testMatch": [
      "**/test/*.test.+(ts|tsx)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
