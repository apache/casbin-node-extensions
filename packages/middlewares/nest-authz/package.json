{
  "name": "nest-authz",
  "version": "2.17.1",
  "description": "Nest.js RBAC & ABAC authorization module based on Node-Casbin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">= 10.13.0"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "clean": "rimraf dist",
    "commit": "git-cz",
    "build": "rimraf dist && rollup -c",
    "prepublish": "yarn lint && yarn build",
    "style": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "release": "standard-version",
    "test": "jest",
    "coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "dreamdevil00",
  "license": "Apache-2.0",
  "dependencies": {
    "casbin": "^5.30.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^9.0.3",
    "@nestjs/core": "^9.0.3",
    "@types/jest": "24.9.0",
    "@types/node": "11.15.50",
    "commitizen": "4.2.4",
    "csv-parse": "^5",
    "cz-conventional-changelog": "3.3.0",
    "jest": "24.9.0",
    "jest-environment-node": "^24.0.0",
    "prettier": "1.19.1",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rimraf": "3.0.1",
    "rxjs": "^6.0.0",
    "standard-version": "8.0.2",
    "ts-jest": "24.3.0",
    "ts-node": "10.0.0",
    "tslint": "5.11.0",
    "typescript": "^5.1.6",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^3.29.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.3 || ^10.0.0",
    "@nestjs/core": "^9.0.3 || ^10.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.5.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/casbin-node-extensions.git",
    "directory": "packages/middlewares/nest-authz"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "NOTICE",
    "DISCLAIMER"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "bugs": {
    "url": "https://github.com/apache/casbin-node-extensions/issues"
  }
}
