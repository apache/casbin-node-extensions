{
  "name": "@casbin/mongo-changestream-watcher",
  "version": "1.3.1",
  "description": "Casbin Watcher based on MongoDB Change Streams",
  "license": "Apache-2.0",
  "main": "lib/cjs/watcher.js",
  "module": "lib/esm/watcher.js",
  "homepage": "https://github.com/apache/casbin-node-extensions/tree/main/packages/watchers/mongo-changestream-watcher#readme",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "repository": {
    "type": "git",
